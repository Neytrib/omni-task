# Run python3 scripts/configure_env.py to create a private .env with random local credentials.
POSTGRES_USER=omni_task
POSTGRES_DB=omni_task
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_POSTGRES_PASSWORD
BOT_API_KEY=REPLACE_WITH_RANDOM_SERVICE_KEY
BOT_IDENTITY=omni-task-local
APP_ENV=development
# Telegram URL buttons require a dotted hostname; use the loopback IP locally.
DASHBOARD_ORIGIN=http://127.0.0.1:8080
COOKIE_SECURE=false
SESSION_TTL_SECONDS=604800
LOGIN_TTL_SECONDS=300
# Pub/Sub channels are global across Redis database numbers; use a unique name per deployment.
LIVE_CHANNEL=omni-task:live:v1
# API-only, injected by Compose; bot receives neither DATABASE_URL nor REDIS_URL.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@postgres:5432/DATABASE
# REDIS_URL=redis://redis:6379/0
# Optional: leave blank to keep Telegram polling explicitly disabled.
# Set a real token only when ready to run this bot against Telegram. Never commit it.
TELEGRAM_BOT_TOKEN=
# Voice intake and decoded-audio limits are enforced by the bot, API and worker.
VOICE_MAX_DURATION_SECONDS=600
VOICE_MAX_BYTES=19000000
# API-only: accepted recordings per rolling 24 hours; queued/processing jobs of any age.
VOICE_USER_DAILY_LIMIT=10
VOICE_GLOBAL_DAILY_LIMIT=50
VOICE_USER_PENDING_LIMIT=2
VOICE_GLOBAL_PENDING_LIMIT=10
VOICE_DOWNLOAD_TIMEOUT_SECONDS=30
VOICE_CONVERSION_TIMEOUT_SECONDS=30
VOICE_PROVIDER_TIMEOUT_SECONDS=90

# Voice providers: disabled (honest failure), fake (explicit demo), or openai.
TRANSCRIPTION_PROVIDER=disabled
TRANSCRIPTION_MODEL=whisper-1
# These values are injected only into the worker. Set after approval for paid calls.
OPENAI_API_KEY=
ALLOW_PAID_TRANSCRIPTION=false
