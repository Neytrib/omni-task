# Copy to /etc/omni-task/production.env, owned by root with mode 0600.
# Use: python3 scripts/production.py --env-file /etc/omni-task/production.env \
#      --project-name omni-task-prod -- COMMAND
# Never reuse a release tag after its images are built. Keep the previous release images.
COMPOSE_PROJECT_NAME=omni-task-prod
RELEASE_TAG=replace-with-release-id
DOMAIN=tasks.example.com
ACME_EMAIL=admin@example.com

# Generate URL-safe values; DATABASE_URL embeds POSTGRES_PASSWORD without URL escaping.
POSTGRES_USER=omni_task
POSTGRES_DB=omni_task
POSTGRES_PASSWORD=replace-with-generated-url-safe-secret
BOT_API_KEY=replace-with-generated-server-only-secret-at-least-32-characters
# Stable identity for this Telegram bot; keep it unchanged when rotating its token.
BOT_IDENTITY=replace-with-telegram-bot-id
TELEGRAM_BOT_TOKEN=

# Production override forces HTTPS origin, APP_ENV=production and Secure cookies.
SESSION_TTL_SECONDS=604800
LOGIN_TTL_SECONDS=300
LIVE_CHANNEL=omni-task:production:live:v1

# Leave disabled until the owner explicitly enables their own paid integration.
TRANSCRIPTION_PROVIDER=disabled
TRANSCRIPTION_MODEL=whisper-1
OPENAI_API_KEY=
ALLOW_PAID_TRANSCRIPTION=false
VOICE_MAX_DURATION_SECONDS=600
VOICE_MAX_BYTES=19000000
# API admission limits; positive values only. These are not a currency billing cap.
VOICE_USER_DAILY_LIMIT=10
VOICE_GLOBAL_DAILY_LIMIT=50
VOICE_USER_PENDING_LIMIT=2
VOICE_GLOBAL_PENDING_LIMIT=10
VOICE_DOWNLOAD_TIMEOUT_SECONDS=30
VOICE_CONVERSION_TIMEOUT_SECONDS=30
VOICE_PROVIDER_TIMEOUT_SECONDS=90
